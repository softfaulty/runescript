  "dependencies": {
    "@tauri-apps/api": "^2",
    "monaco-editor": "^0.56.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "vite": "^8.0.16",
    "typescript": "~6.0.3"
  }
}
